[
    {
        "op": "symlink",
        "src": "home/config/*",
        "dest": "~/.config/"
    },
    {
        "op": "symlink",
        "src": "home/fonts/*",
        "dest": "~/.fonts/"
    },
    {
        "op": "symlink",
        "src": "home/scripts/*",
        "dest": "~/.scripts/"
    },
    {
        "op": "symlink",
        "src": "home/local/share/nemo/actions",
        "dest": "~/.local/share/nemo/actions"
    },
    {
        "op": "symlink",
        "src": "home/zshrc",
        "dest": "~/.zshrc"
    },
    {
        "op": "symlink",
        "src": "home/zprofile",
        "dest": "~/.zprofile"
    },
    {
        "op": "copy",
        "src": "home/Pictures/wallpapers",
        "dest": "~/Pictures/wallpapers"
    }
]
