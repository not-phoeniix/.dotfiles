# runs when logging into a TTY, ill only put
#   environment variables in here <3

# path config stuff
export MGFXC_WINE_PATH="$HOME/.winemonogame"
export XDG_CACHE_HOME=$HOME/.cache/
export XDG_CONFIG_HOME=$HOME/.config/
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$HOME/.local/lib/
export PATH=$PATH:$HOME/.scripts:$HOME/.local/bin

export EDITOR="nvim"
export VISUAL="nvim"
export TERM="foot"
export TERMINAL="foot"
export GOPATH"=$HOME/Go"
export DOTNET_CLI_TELEMETRY_OPTOUT=true
export AWWW_TRANSITION_STEP=30
export SCREENSHOT_DIR=$HOME/Pictures/Screenshots

# pfetch
export PF_INFO="ascii title os kernel wm shell pkgs memory"
export PF_COL1=5
export PF_COL2=7
export PF_COL3=3

